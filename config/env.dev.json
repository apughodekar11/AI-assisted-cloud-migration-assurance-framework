{
  "service_names": ["users", "orders"],
  "region": "eu-west-1",
  "db": { "engine": "postgres", "size": "small" },
  "telemetry": { "otel": true, "metrics": ["latency_p95", "error_rate", "cpu_p95"] },
  "validation": {
    "smoke": { "retries": 2, "timeout_s": 5 },
    "anomaly_threshold": { "latency_p95_ms": 350, "error_rate_pct": 1.0 }
  },
  "policies": { "opa_bundle_url": "s3://opa-bundles/base/v1" },
  "cost_carbon": { "collect_cost": true, "collect_carbon": true }
}

